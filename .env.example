# RIMURU v2.1 — copy to .env and fill in what you have.
# Minimum to boot: PAIRING_NUMBER + CLAIM_PASSPHRASE + at least one AI key.

# --- WhatsApp pairing ---
# Rimuru's own number, digits only with country code (no +, no spaces, no leading 0)
PAIRING_NUMBER=

# Owner claim passphrase (send ".claim <this>" to Rimuru in private chat)
CLAIM_PASSPHRASE=

# --- AI keys (order: Groq -> DeepSeek -> Gemini; at least one) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# --- Bot identity ---
PREFIX=.
PERSONALITY=savage            # savage = teasing Tempest (default), calm = mellow Tempest
OWNER_NAME=Kennedy
OWNER_NUMBER=                 # owner WhatsApp number(s), comma separated
DEV_NAME=CHAD FDEV
DEV_TEAM=VECTOR-MD

# --- Optional ---
PORT=3000
# DATABASE_URL=               # only for hosts with no disk (pg)
# COBALT_API_URL=             # for YouTube/Instagram/etc. downloads via .dl
# COBALT_API_KEY=
# DL_MAX_MB=60
